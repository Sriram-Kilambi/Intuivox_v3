// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id String @id @default(uuid())
  name String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Track the active conversation thread for this project
  activeThreadId String? @unique
  activeThread Thread? @relation(fields: [activeThreadId], references: [id], onDelete: SetNull)

  messages Message[]
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
  AGENT_QUESTION
}

model Message {
  id String @id @default(uuid())
  content String
  role MessageRole
  type MessageType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fragment Fragment?

  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // For conversation history (optional)
  threadId String?
  thread Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  agentName String?
}

model Thread {
  id String @id @default(uuid())
  title String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  
  // Relation to track which project this is the active thread for
  activeForProject Project?
}

model Fragment {
  id String @id @default(uuid())
  messageId String @unique
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sandboxUrl String
  title String
  files Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usage {
  key String @id
  points Int
  expire DateTime?
}