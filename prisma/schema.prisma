// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id String @id @default(uuid())
  name String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
  AGENT_QUESTION
}

model Message {
  id String @id @default(uuid())
  content String
  role MessageRole
  type MessageType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fragment Fragment?

  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Fragment {
  id String @id @default(uuid())
  messageId String @unique
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sandboxUrl String
  title String
  files Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deployments Deployment[]
}

model Usage {
  key String @id
  points Int
  expire DateTime?
}

model UserRailwayConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  accessToken String   // Railway API token (encrypted)
  teamId      String?  // Railway team ID if applicable
  email       String   // Railway account email
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deployments Deployment[]

  @@map("user_railway_connections")
}

model Deployment {
  id String @id @default(uuid())
  
  // Fragment relationship
  fragmentId String
  fragment   Fragment @relation(fields: [fragmentId], references: [id], onDelete: Cascade)
  
  // User relationship
  userId String
  
  // Railway deployment info
  railwayProjectId   String // Railway project ID
  railwayServiceId   String // Railway service ID  
  railwayDeploymentId String? // Specific deployment ID
  
  // Deployment details
  deploymentUrl String // Generated Railway URL
  customDomain  String? // User's custom domain (if provided)
  
  // Status tracking
  status DeploymentStatus @default(CREATING)
  buildLogs String? // Build output logs
  errorMessage String? // Error details if failed
  
  // Metadata
  projectName String // Generated project name
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Railway connection
  railwayConnection UserRailwayConnection @relation(fields: [userId], references: [userId])

  @@map("deployments")
}

enum DeploymentStatus {
  CREATING     // Creating Railway project
  BUILDING     // Building the application
  DEPLOYING    // Deploying to Railway
  LIVE         // Successfully deployed and live
  FAILED       // Deployment failed
  UPDATING     // Updating existing deployment
}